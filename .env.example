# Use a dedicated database. Never reuse a production application's database.
DATABASE_URL=postgresql://sotto:sotto@localhost:5438/sotto
POSTGRES_PASSWORD=sotto
APP_URL=http://localhost:3000
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Explicitly list accounts belonging to this installation's owner.
ALLOWED_GOOGLE_EMAILS=you@yourcompany.com,you@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Optional. No model key means no model classification and no automatic moving.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Independent global switch. Keep false during evaluation.
ENABLE_MAILBOX_WRITES=false
# Optional synthetic, isolated UI preview. Never connects to Gmail.
DEMO_MODE=false
