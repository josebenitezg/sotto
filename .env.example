# Use a dedicated database. Never reuse a production application's database.
DATABASE_URL=postgresql://sotto:sotto@localhost:5438/sotto
# Neon: use its direct connection for session advisory locks.
DATABASE_URL_UNPOOLED=
POSTGRES_PASSWORD=sotto
APP_URL=http://localhost:3000
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Explicitly list accounts belonging to this installation's owner.
ALLOWED_GOOGLE_EMAILS=you@yourcompany.com,you@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Optional. No model key means no model classification and no automatic moving.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# openai (direct key) or vercel (AI Gateway with deployment OIDC)
AI_PROVIDER=openai
AI_GATEWAY_API_KEY=
# worker (self-hosted process) or vercel (managed queue + daily recovery)
QUEUE_DRIVER=worker
CRON_SECRET=
# Independent global switch. Keep false during evaluation.
ENABLE_MAILBOX_WRITES=false
# Optional synthetic, isolated UI preview. Never connects to Gmail.
DEMO_MODE=false

# Hosted subscription mode. Self-hosted installations keep billing disabled.
BILLING_ENABLED=false
PUBLIC_SIGNUP=false
# Enable only after Gmail, billing webhooks and commercial hosting are ready.
CHECKOUT_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
PLAN_PRICE_CENTS=900
# false: no card for the 3-day trial; it cancels without a payment method.
TRIAL_REQUIRE_CARD=false
